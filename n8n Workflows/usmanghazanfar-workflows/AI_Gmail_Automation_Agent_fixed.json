      "typeVersion": 1.4,
      "position": [
        0,
        192
      ],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {
          "readStatus": "unread",
          "q": "-subject:\"[High Priority]\" -from:me"
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "IlG8uCvjv2r1mPTv",
