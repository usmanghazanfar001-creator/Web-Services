    {
      "id": "abd4aea7-7dfd-4ab1-a2f1-22b1eb960a7b",
      "name": "Clean & Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        192
      ],
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst b = raw.body || raw;\nconst clean = v => String(v ?? '').trim();\nconst name = clean(b.name);\nconst phoneRaw = clean(b.phone).replace(/[^\\d+]/g, '');\nconst email = clean(b.email).toLowerCase();\nconst emailOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\nlet wa = phoneRaw.replace(/^\\+/, '');\nif (wa.startsWith('00')) wa = wa.slice(2);\nelse if (wa.startsWith('0')) wa = '92' + wa.slice(1);\nconst phoneOk = wa.length >= 10 && wa.length <= 15;\nconst honeypot = clean(b.company_url);           // hidden field: bots fill it, humans don't\nconst valid = !honeypot && name.length > 1 && (phoneOk || emailOk);\nreturn [{ json: {\n  valid,\n  name,\n  phone: phoneOk ? phoneRaw : '',\n  whatsapp: phoneOk ? wa : '',\n  email: emailOk ? email : '',\n  city: clean(b.city),\n  interest: clean(b.interest),\n  budget: clean(b.budget),\n  message: clean(b.message).slice(0, 2000),\n  source_page: clean(b.source_page),\n  received_at: new Date().toISOString()\n}}];"
      }
    },
